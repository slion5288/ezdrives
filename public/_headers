# Cache hashed assets forever (filename hash changes on every deploy)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos change rarely — short cache so the browser revalidates soon
/hero/*
  Cache-Control: public, max-age=3600
/course/*
  Cache-Control: public, max-age=3600

# Never cache the shell
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Service worker + manifest must never be browser-cached, otherwise a cache
# policy fix (or any SW change) would take up to days to reach clients.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
